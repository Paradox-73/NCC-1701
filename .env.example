# Copy to server/.env for local development. With NODE_ENV=production the server refuses these public example values.
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/ncc1701
JWT_SECRET=dev-only-secret-change-me
DEVICE_KEY=dev-device-key
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# 1 runs the simulator inside the server process (free hosting without a background worker)
SIM_EMBED=0
